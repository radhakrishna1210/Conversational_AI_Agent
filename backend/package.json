{
  "name": "conversational-ai-backend",
  "version": "1.0.0",
  "description": "WhatsApp Business SaaS backend",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "predev": "prisma generate && node scripts/prisma-migrate-deploy.js",
    "dev": "node --env-file=.env --watch-path=src src/server.js | pino-pretty --colorize --translateTime=SYS:standard",
    "dev:tunnel": "node scripts/start-with-tunnel.mjs",
    "phone:check": "node --env-file=.env scripts/check-phone-ready.mjs",
    "plivo:check": "node --env-file=.env scripts/check-plivo-numbers.mjs",
    "phone:verify": "node --env-file=.env scripts/verify-twilio-number.mjs",
    "prestart": "prisma generate && node scripts/prisma-migrate-deploy.js",
    "start": "node --env-file=.env src/server.js",
    "worker": "node --env-file=.env src/workers/workerBootstrap.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "node scripts/prisma-migrate-deploy.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset",
    "test": "node --test \"src/services/**/__tests__/*.test.js\" \"src/constants/__tests__/*.test.js\" \"src/lib/__tests__/*.test.js\" \"src/config/__tests__/*.test.js\" \"src/validators/__tests__/*.test.js\"",
    "test:voice": "node --test \"src/services/voice/__tests__/*.test.js\"",
    "test:stt": "node --test \"src/services/stt/__tests__/*.test.js\"",
    "test:ws": "node --test \"src/ws/__tests__/*.test.js\"",
    "test:billing": "node --env-file=.env --test \"src/services/billing/__tests__/*.test.js\"",
    "db:clean-test-data": "node --env-file=.env scripts/clean-test-data.js"
  },
  "dependencies": {
    "@azure/openai": "^2.0.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google/generative-ai": "^0.21.0",
    "@msgpack/msgpack": "^3.1.3",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "node-fetch": "^3.3.2",
    "openai": "^4.52.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "undici": "^7.29.0",
    "ws": "^8.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}
