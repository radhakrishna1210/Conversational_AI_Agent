# Server
NODE_ENV=development
PORT=4000

# Database (SQLite for local development)
DATABASE_URL="file:./dev.db"

# Redis (optional, enables queues and scheduled jobs)
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Roles
# Platform owner. Full access to everything, including the /admin panel.
# Everyone else is a Member. Set this to the owner's login email.
SUPER_ADMIN_EMAIL=

# Encryption for stored integration tokens and credentials
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Frontend / app URLs
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
JSON_BODY_LIMIT=2mb
# Days call audio is kept on disk before deletion; 0 keeps it forever.
# Call logs and transcripts are never deleted by this.
RECORDING_RETENTION_DAYS=7
# Server-side recording of phone/campaign calls (web calls are recorded by the
# browser and are unaffected). `off` disables it.
PHONE_RECORDING=on

# Security and workers
BCRYPT_SALT_ROUNDS=12
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_WORKER_CONCURRENCY=2
START_CAMPAIGN_WORKER=false

# Meta / WhatsApp Cloud API
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
META_API_VERSION=v19.0
META_BUSINESS_ID=
META_SYSTEM_USER_TOKEN=

# Integration OAuth secrets
CAL_CLIENT_ID=
CAL_CLIENT_SECRET=
CAL_REDIRECT_URI=http://localhost:4000/api/v1/integrations/cal/callback

CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:4000/api/v1/integrations/calendly/callback

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/salesforce/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google_calendar/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/v1/integrations/slack/callback
SLACK_SIGNING_SECRET=

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:4000/api/v1/integrations/hubspot/callback

GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_REDIRECT_URI=http://localhost:4000/api/v1/integrations/genesys/callback
GENESYS_REGION=mypurecloud.com

# xAI Grok Voice Agent (optional — bundled speech-to-speech engine, selectable
# per-agent as an alternative to the modular Voice/LLM/STT pipeline)
XAI_API_KEY=
XAI_VOICE_WS_URL=wss://api.x.ai/v1/realtime
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE_NAME=
# Public wss:// origin for the carrier to reach this backend's media-stream
# bridge. Required for two-way phone calls on every carrier. For India it must
# resolve to India-hosted infrastructure — call media leaving the country fails
# the media-anchoring rule.
PUBLIC_BACKEND_WS_URL=

# ElevenLabs Conversational AI (optional — second bundled speech-to-speech
# engine option, alongside xAI above). Reuses ELEVENLABS_API_KEY already
# configured for TTS. ELEVENLABS_CONVAI_AGENT_ID is a "shell" Agent you must
# create once in the ElevenLabs dashboard (Agents Platform) with Prompt/First
# Message/Language overrides enabled in its Security settings.
ELEVENLABS_CONVAI_AGENT_ID=

# Optional API base overrides
CAL_API_BASE_URL=https://api.cal.com
CALENDLY_API_BASE_URL=https://api.calendly.com
SALESFORCE_INSTANCE_URL=
GOOGLE_API_BASE_URL=https://www.googleapis.com
SLACK_API_BASE_URL=https://slack.com/api
HUBSPOT_API_BASE_URL=https://api.hubapi.com
GENESYS_API_BASE_URL=

# ─── Billing / payments (BUG-002) ────────────────────────────────────────────
# Razorpay. Generate at dashboard.razorpay.com -> Settings -> API Keys.
# Start in TEST mode; test and live keys are entirely separate key pairs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set separately under Settings -> Webhooks. NOT the same value as KEY_SECRET,
# and it differs between test and live mode. The webhook fails CLOSED when this
# is unset, so top-ups will be rejected rather than silently trusted.
RAZORPAY_WEBHOOK_SECRET=

# Wallet is denominated in this currency's minor units (paise for INR).
BILLING_CURRENCY=INR
# Plans are catalogued in USD; this converts them at charge time. The rate used
# is recorded on every ledger row so historical charges stay reproducible.
# Matches docs/VOICE_AGENT_PRICE_PER_MINUTE.md (re-verified 2026-07-24).
FX_USD_TO_INR=96
# Rounding granularity for call duration. 60 = per-minute (default), 1 = per-second.
BILLING_INCREMENT_SEC=60
# Charged when a workspace has no resolvable plan. Deliberately the most
# expensive published rate: failing open on price would allow unlimited free usage.
FALLBACK_PER_MINUTE_USD=0.12
# Top-up bounds in minor units. Defaults: 10000 = INR 100, 5000000 = INR 50,000.
MIN_TOPUP_CENTS=10000
MAX_TOPUP_CENTS=5000000
# GST or equivalent, as a percentage. 0 (default) invents no tax line.
BILLING_TAX_PERCENT=0

# ── Voice latency pipeline (web calls) ───────────────────────────────────────
# First-sentence split: stream the LLM and speak sentence 1 while the rest is
# still generating (any streaming TTS provider). Set to false to disable.
VOICE_SENTENCE_SPLIT=true
# Filler acknowledgments ("mm-hmm") while the LLM thinks. Follows each agent's
# "Filler Words" toggle; 'always' forces on globally, 'false' kills globally.
# VOICE_FILLER=
# How long to wait for real reply audio before playing a filler (ms).
VOICE_FILLER_DELAY_MS=400

# How long a speech_final candidate waits when the transcript ends MID-THOUGHT
# ("...book an appointment for", "...like, which"). Silence length cannot tell
# "finished" from "thinking", so the tail of the transcript decides — see
# looksUnfinished() in services/stt/deepgramStream.service.js. Only paid on
# turns that actually dangle, so normal turns keep the fast 400ms path.
DEEPGRAM_UNFINISHED_GRACE_MS=1100
# Echo guard: fraction of a "caller" transcript that must be one VERBATIM run of
# the agent's own previous reply before the turn is discarded as the agent's
# voice coming back through the caller's speakers. High on purpose — dropping a
# real turn makes the agent deaf, which is worse than the bug it prevents.
STT_ECHO_SIMILARITY=0.75
# Below this many characters, echo and coincidence cannot be told apart ("okay").
STT_ECHO_MIN_CHARS=8
# Peak level before loudness counts as evidence of an agitated caller. It must
# ALSO be corroborated by a fast delivery rate — loudness alone was labelling
# anyone with a close mic as frustrated.
AFFECT_AGITATED_PEAK_RMS=0.45

# ── Naturalness (see services/voice/disfluency.js) ───────────────────────────
# Longest single <break/> pause the agent may take mid-reply (ms). Natural
# thinking-pauses in running speech are ~200-400ms; much past that and a 1-2
# sentence reply sounds like the audio cut out rather than like thought.
VOICE_MAX_BREAK_MS=400
# Pauses allowed per reply. Replies are 1-2 sentences, so 1 well-placed pause
# (right after the opener) is the whole budget; more scatters silence around.
VOICE_MAX_BREAKS_PER_REPLY=1
# ElevenLabs latency-optimization level, 0-3. A WARMTH/LATENCY DIAL: every step
# up trades prosodic planning for speed. 3 audibly flattens intonation into a
# single tone, so the default is now 2. Raise to 3 for speed, drop to 1/0 for
# maximum warmth.
# ELEVENLABS_STREAMING_LATENCY=2
# Characters buffered before each WebSocket audio chunk. The first value sets
# time-to-first-byte AND how much text the model gets to plan intonation over —
# at 50 the opening of every reply is planned nearly blind. Ascending, max 4.
# ELEVENLABS_CHUNK_SCHEDULE=50,120,160,290

# ── Fish Audio (TTS + voice cloning) ─────────────────────────────────────────
# TTS/STT/cloning provider — NOT a conversational agent (it has no LLM API), so
# it fills the Voice (TTS) slot of the modular pipeline. Everything below stays
# dormant until FISH_API_KEY is set: no voices sync, health reports unhealthy,
# and the provider can never be selected. Get a key at https://fish.audio
# FISH_API_KEY=
# HTTP synthesis model. s2.1-pro-free is the FREE developer tier — identical
# weights to s2.1-pro, no API credit required, but no TTFA/uptime guarantee and
# requests may be used to improve Fish's models (so do NOT use it for calls
# carrying personal or medical data). The paid ids (s2.1-pro, s2-pro, s1) all
# return 402 unless the account's API-credit wallet is funded; that wallet is
# separate from platform credit.
FISH_TTS_MODEL=s2.1-pro-free
# WebSocket (token-streaming) model — SEPARATE knob on purpose. Leave it UNSET
# on the free tier: /v1/tts/live accepts a -free model then never emits audio
# (it hangs, rather than 402ing), so wsModel() mirrors a -free FISH_TTS_MODEL
# and canStreamTokens() switches the runtime to the HTTP split path instead.
# Set it only alongside a funded key; verify with scripts/probe-fish.js.
# FISH_TTS_WS_MODEL=s2-pro
# Output container. mp3 is the only format the browser client decodes today;
# opus is sniffed (OggS) but untested end-to-end, and pcm has no header at all.
FISH_TTS_FORMAT=mp3
# Chars per synthesis chunk on live calls (100-300). Lower = faster first audio.
FISH_CHUNK_LENGTH=150
# Ask Fish to synthesize each sentence immediately on the WS path instead of
# waiting for more text. The main latency lever; set false if the seam between
# sentences sounds clipped.
# FISH_WS_FLUSH=false
# s1-style "(emotion)" tags. OFF by default and double-gated (also requires an
# s1 model): on s2.x an unsupported tag is likely SPOKEN ALOUD to the caller.
# Verify with `node --env-file=.env scripts/probe-fish.js --save` first.
# FISH_EMOTION_TAGS=true
# Visibility for voices cloned through Fish Audio.
FISH_CLONE_VISIBILITY=private
# Which provider handles new voice clones: fishaudio | elevenlabs. Defaults to
# the first one with a configured key.
# VOICE_CLONE_PROVIDER=fishaudio
# Hand-pick exactly which Fish voices the picker offers, instead of syncing the
# library's top-scored ones. Format: "id:Name:lang:gender,id2:..." — only the id
# is required, and the id is the last path segment of the voice's fish.audio URL
# (its model _id / reference_id). Anything you type after the id overrides what
# the API reports, so you can relabel a voice for your own team.
# When set, the public score-sorted sweep below is SKIPPED; your own models and
# clones (self=true) are still always included. Doubles as the escape hatch if
# the model-listing API shape ever differs from what getVoices() expects.
# Re-run a sync after changing this: POST /api/workspaces/:id/voices/sync
# FISH_VOICE_IDS=
# How many public library voices to pull on sync, split across the languages
# below and paged 100 at a time. Fish's own result window stops at 1000 per
# language+sort query (max_offset, verified live 2026-08-19), so ~2000 is the
# practical ceiling for "en,hi" — the library is larger than any single query
# can reach. Every voice pulled becomes a row and a card in the picker, so raise
# this for reach and lower it for a shorter list.
FISH_VOICE_LIMIT=200
# Languages to pull voices FOR, in preference order. Sorting the library by
# score alone returns globally popular voices (Spanish/Arabic/English) and zero
# Hindi. This also decides which language a MULTILINGUAL voice is filed under,
# since the picker filters on a single language column — put your primary
# language first (e.g. "hi,en" for a Hindi-first deployment).
FISH_VOICE_LANGUAGES=en,hi

# ── Sarvam AI (voices) ───────────────────────────────────────────────────────
# Sarvam publishes no list-speakers endpoint, so the roster is discovered from
# the API's own validation errors on startup/sync and cached for an hour. The
# provider only offers speakers that appear in BOTH the "recognized" list and
# the per-model compatible list — each one alone names speakers that 400 on a
# real call (measured 2026-08-19: v3 refuses "anushka"; "niharika" is listed as
# v3-compatible and then comes back "not recognized" on synthesis).
#
# TTS model. Changing it changes the roster: bulbul:v3 refuses the v2-era
# speakers (anushka, abhilash, hitesh, manisha, vidya, arya, karun).
# SARVAM_TTS_MODEL=bulbul:v3
# Language a Sarvam voice is filed and synthesised under when we hold no curated
# entry for that speaker. Every bulbul speaker can speak every supported
# language — the language comes from target_language_code at synthesis time, not
# from the speaker — but a Voice row carries exactly one code, and this is it.
# Set it to your deployment's primary language.
# SARVAM_DEFAULT_LANGUAGE=hi-IN

# ── Background ambience on phone calls ───────────────────────────────────────
# Each agent picks its own bed in Call Configuration -> Ambient Sound; this is
# a global kill switch for the PHONE leg only (web calls are client-side and
# unaffected). Set to false to fall back to the original zero-transcode
# passthrough without touching any agent's config.
# With an agent's ambience set to "None" (the default) nothing here runs at all:
# no timer, no mixing, no added latency.
# AMBIENCE_PHONE_ENABLED=false

# Timezone appointments are booked in when the extracted date/time carries no
# offset of its own (the normal case — extraction asks the model for a bare
# YYYY-MM-DDThh:mm:ss). MUST NOT be left to the server's local zone: a caller
# saying "3 PM" means 3 PM where THEY are, and deriving it from the host makes
# the same call book different times in dev and production.
APPOINTMENT_TIMEZONE=Asia/Kolkata

# How long an IN_PROGRESS call may sit before it is treated as abandoned rather
# than active. A web call is only marked ended by the BROWSER, so a closed tab
# or crash leaves the row in progress forever — without this bound those rows
# permanently consumed a plan concurrency slot and silently blocked new calls
# from being logged or billed. Must comfortably exceed the longest agent call
# (max configurable duration is 30 min). Default 2h.
STALE_CALL_MS=7200000

# ── TRAI / DLT compliance (India outbound) ─────────────────────────────────
# off | warn | enforce. Keep on "warn" until every active workspace has been
# onboarded: "enforce" refuses Indian outbound calls from any workspace without
# a verified DLT Principal Entity ID. Non-Indian caller IDs are never gated.
DLT_COMPLIANCE_MODE=warn
# Our telemarketer (aggregator) ID, which each client declares in their own DLT
# portal to bind their Principal Entity to our infrastructure. Leave blank until
# it is issued.
PLATFORM_TM_ID=

# ─── Integration auto-sync ───────────────────────────────────────────────────
# A failed sync never advances lastSyncAt, so before the backoff existed the
# 60s sweep re-queued every broken integration on every tick, forever. Measured
# on one deployment: 241,776 failed jobs, oldest 41 days back, several new
# failures a second — enough to saturate the Prisma pool and take /auth/refresh
# down with it, logging users out mid-session.
#
# A failing integration now retries after BASE, then doubles, capped at MAX.
# Capped rather than abandoned: an expired token usually gets re-authorised
# eventually, and an integration that never retries is a quieter outage. A
# successful sync, or reconnecting it, clears the penalty immediately.
# INTEGRATION_SYNC_INTERVAL_MS=60000
# INTEGRATION_BACKOFF_BASE_MS=300000
# INTEGRATION_BACKOFF_MAX_MS=21600000

# ─── Web call startup deadlines ──────────────────────────────────────────────
# Two deadlines, because two different things can be slow and they need
# different answers.
#
# WEB_CALL_AUTH_TIMEOUT_MS is how long the BROWSER gets to send its auth frame.
# It reaps sockets that connect and then say nothing. Cleared the instant that
# frame arrives.
#
# WEB_CALL_STARTUP_TIMEOUT_MS is how long the SERVER then gets to make the call
# ready — loading the agent and clearing the wallet gate, both remote database
# work. It has to be much larger: measured at 21.6s for the gate alone when the
# database was degraded, against the 10s that used to cover both steps. When one
# timer covered both, a browser that authenticated in 40ms was hung up on for
# the server's own slowness and the log blamed the browser ("Auth timeout").
#
# WEB_CALL_STARTUP_SLOW_MS logs a warning on any startup slower than this even
# when it succeeds — the early warning that the path is drifting toward the
# timeout above.
# WEB_CALL_AUTH_TIMEOUT_MS=10000
# WEB_CALL_STARTUP_TIMEOUT_MS=30000
# WEB_CALL_STARTUP_SLOW_MS=3000

# ─── Batch STT fallback ──────────────────────────────────────────────────────
# Used only when the streaming recogniser produced nothing for a turn (socket
# still connecting, died mid-call, or not configured). The agent's own STT
# choice decides which provider runs first; Deepgram, Sarvam and ElevenLabs all
# have a batch implementation, and whichever has credentials fills in behind.
#
# The per-request ceiling was 4.5s on the reasoning that this is dead air. It
# optimised the wrong thing: a timeout here means NO transcript, so the caller
# repeats themselves and pays a whole extra turn. Measured on this deployment,
# the same clip took 4526ms cold and 3091ms warm, so 4.5s lost about half of
# all cold fallbacks.
# STT_BATCH_TIMEOUT_MS=8000
# DEEPGRAM_BATCH_MODEL=nova-2

# ─── Outbound HTTP connection reuse ──────────────────────────────────────────
# Node's default fetch pool drops an idle socket after 4 SECONDS. A
# conversational turn gap is 5-30s, so without this almost every voice turn
# re-pays a TCP + TLS handshake to the STT, LLM and TTS providers — measured at
# roughly 300ms per provider, twice per turn, attributed to no stage in any
# metric. Applies to every provider a workspace can pick; see
# src/lib/httpKeepAlive.js. Defaults are usually right; raise
# HTTP_POOL_CONNECTIONS on a box running large bulk campaigns.
# HTTP_KEEPALIVE_TIMEOUT_MS=60000
# HTTP_KEEPALIVE_MAX_TIMEOUT_MS=300000
# HTTP_POOL_CONNECTIONS=64
# HTTP_CONNECT_TIMEOUT_MS=10000

# ─── Reply delivery (platform kill switch only) ──────────────────────────────
# Whether an agent may stream its reply into TTS as the words are generated,
# instead of synthesizing a sentence at a time. This is now a PER-AGENT setting
# (Agent editor -> Call Configuration -> Response -> Reply Delivery), and it is
# on by default wherever the agent's chosen voice supports it. This variable
# exists only to take the streaming path out of service platform-wide:
#   VOICE_TTS_OVERLAP=false
# Any other value (or unset) leaves the decision to each agent.

# ─── Turn-end timing (fallback for agents that have not chosen) ──────────────
# How long to wait after the caller stops speaking before answering. Also now a
# per-agent setting (Response -> Reply Timing: Fast / Balanced / Patient), and
# an agent that has chosen a profile IGNORES these. They still apply to agents
# that have never been configured, so an existing deployment keeps the timings
# it runs today. Profile values live in src/services/voice/turnEndProfile.js.
# DEEPGRAM_ENDPOINTING_MS=300
# DEEPGRAM_ENDPOINT_GRACE_MS=400
# DEEPGRAM_UNFINISHED_GRACE_MS=1100
# The SHORT window used when the transcript has clearly handed over the floor
# (a question mark, a Hindi danda, a standalone "yes") — see looksFinished().
# Never longer than the ordinary grace. Set DEEPGRAM_FINISHED_GRACE=false to
# switch the tier off platform-wide (every finished tail then waits the
# ordinary window, as before).
# DEEPGRAM_FINISHED_GRACE_MS=150
# DEEPGRAM_FINISHED_GRACE=true

# ── Speculative replies, local endpointing, transfer, ambience (2026-09-04) ──
# Per-agent setting `speculation` (off | candidate | interim) wins; this is the
# platform default for agents that have not chosen, and `off` is the kill switch.
# VOICE_SPECULATION=candidate
# What the server's own frame VAD may do with a silence: speculate (default),
# commit (asks Deepgram to flush and arms the turn end — measured to cut
# mid-sentence pauses, keep off), or off.
# VOICE_LOCAL_ENDPOINTING=speculate
# DEEPGRAM_LOCAL_FLUSH_TIMEOUT_MS=500
# Interim-mode speculation tuning.
# VOICE_SPECULATION_DEBOUNCE_MS=180
# VOICE_SPECULATION_MIN_DELTA=4
# Live human transfer: HMAC secret for carrier callback URLs (falls back to
# JWT_ACCESS_SECRET) and the public HTTP base the carriers call back on
# (derived from PUBLIC_BACKEND_WS_URL / PLIVO_ANSWER_URL when unset).
# TRANSFER_CALLBACK_SECRET=
# PUBLIC_BACKEND_HTTP_URL=
# Pre-rendered ambience beds (scripts/build-chatter-bed.mjs) live here.
# AMBIENCE_ASSET_DIR=
# Subscription renewal sweep (legacy plans layer). Set to false to stop the
# hourly sweep while the legacy/prepaid decision is pending.
# SUBSCRIPTION_RENEWAL_ENABLED=true
