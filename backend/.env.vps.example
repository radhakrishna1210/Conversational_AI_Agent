# ─────────────────────────────────────────────────────────────────────────────
# Hostinger VPS (62.72.12.185) — spandan.mannmate.com — TEMPLATE
#
# Lives at /root/apps/convai-voice/shared/.env and is symlinked to
# backend/.env, so `git reset --hard` on each deploy cannot destroy it.
#
# This file is COMMITTED. Never paste real secrets here.
#
# SYNTAX WARNING: deploy.sh sources this file with `. .env` to run migrations,
# so it must be valid shell. Any value containing a space, #, & or $ MUST be
# single-quoted. DATABASE_URL below is quoted for exactly that reason (it has &).
#
#   [REQUIRED]  src/config/env.js throws on boot without it
#   [NEEDED]    a feature is silently dead without it
#   [OPTIONAL]  has a working default
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# [REQUIRED] 4300 is not arbitrary — it was the first free port on this shared
# box. Already bound by other projects: 3000, 3001, 3100, 3200, 4000
# (blog-backend), 5000, 5100 (mannmate-backend), 6379, 8000, 8001, 9100, 27017.
# Changing it means changing ecosystem.config.cjs and the nginx proxy_pass too.
PORT=4300


# ── Database (hosted Supabase — NOT the local mongod on this VPS) ────────────
# [REQUIRED] POOLED connection, port 6543. env.js:15 validates the protocol.
# The pgbouncer + connection_limit params are not optional: without them Prisma
# opens a pool per process and exhausts Supabase's connection cap.
#
# 5, not 1. connection_limit is how many queries this process may run AT ONCE,
# and each one is a ~490ms round trip from this VPS to Supabase. At 1 every
# query in the app waits for the one before it: a bulk campaign's dialer, each
# answered call's wallet gate and each finished call's settlement all queue on
# one connection, and callers hear it as seconds of silence before the greeting.
# The 6543 pooler multiplexes client connections over its own pool, so five from
# one PM2 process is well inside Supabase's client limit. The server logs a
# warning at boot while this is still 1.
# Quoted because of the & between the query params.
DATABASE_URL='postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5'

# [REQUIRED] DIRECT connection, port 5432. prisma/schema.prisma:8 declares
# directUrl and migrations run through it — PgBouncer in transaction mode
# cannot execute DDL, so `prisma migrate deploy` against 6543 fails.
DIRECT_URL='postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres'


# ── Auth / crypto ────────────────────────────────────────────────────────────
# [REQUIRED] Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<GENERATE_32_PLUS_CHARS>
JWT_REFRESH_SECRET=<GENERATE_32_PLUS_CHARS_DIFFERENT>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# [REQUIRED] COPY VERBATIM from your local backend/.env. Do NOT generate a new
# one: this key decrypts integration tokens already stored in the live Supabase
# database. A fresh value makes every saved OAuth credential permanently
# unreadable, and there is no recovery path.
#
# It also decrypts every Plivo subaccount token, so a wrong value stops all
# India calling outright (CARRIER_CREDENTIALS) rather than degrading — which is
# deliberate: the alternative is silently billing clients' calls to our own
# parent account. Subaccount tokens ARE recoverable (Admin -> Numbers & Carrier
# -> relink refetches them from Plivo); OAuth credentials are not.
ENCRYPTION_KEY=<COPY_EXACTLY_FROM_LOCAL_backend/.env>

BCRYPT_SALT_ROUNDS=12

# [NEEDED] Without it nobody can reach /admin.
SUPER_ADMIN_EMAIL=<YOUR_LOGIN_EMAIL>


# ── Self-referencing URLs ────────────────────────────────────────────────────
# [NEEDED] CORS allowlist (app.js:16-17). In production the localhost fallbacks
# are excluded, so a wrong value here rejects every API call from your own page.
CLIENT_URL=https://spandan.mannmate.com

# [NEEDED for phone calls] The wss:// origin Twilio dials for Media Streams.
# Unset, bundled-engine phone calls silently degrade to greeting-only rather
# than erroring — so a typo here is invisible until someone calls in.
PUBLIC_BACKEND_WS_URL=wss://spandan.mannmate.com


# ── Uploads ──────────────────────────────────────────────────────────────────
# Absolute, and OUTSIDE the git working tree. KB files, cloned voices and call
# recordings are written here; anything under repo/ would be at the mercy of
# `git reset --hard` on every deploy.
UPLOAD_DIR=/root/apps/convai-voice/shared/uploads
MAX_FILE_SIZE_MB=10
JSON_BODY_LIMIT=2mb

# Days call audio is kept before it is deleted from disk. The call log,
# transcript and billing rows are permanent — only the audio file goes.
# This box has five other production apps on the same disk, so 0 (keep
# forever) is not a safe setting here.
RECORDING_RETENTION_DAYS=7

# Server-side recording of phone and campaign calls. Both legs are mixed to one
# 8kHz mono WAV, ~960KB per minute — sized against RECORDING_RETENTION_DAYS
# above, since nothing else bounds it. `off` disables it.
PHONE_RECORDING=on


# ── Queues (Redis shared with another app on this box) ───────────────────────
# The /3 suffix is the database index and is what keeps BullMQ's keys away from
# the project already using this instance. The password is in
# /etc/redis/redis.conf under `requirepass`.
#
# ALSO REQUIRED: `maxmemory-policy noeviction`. That setting is GLOBAL to the
# redis instance, so confirm it does not break the other project before setting
# it. Under an eviction policy BullMQ loses jobs silently.
# (Verified 2026-08-07: already noeviction on this box, and db3 is unused.)
#
# PERCENT-ENCODE THE PASSWORD. The one on this box contains '@' and '#'. Left
# raw, '@' makes the URL parser treat the host as part of the credentials and
# the client connects somewhere else entirely; '#' additionally starts a comment
# when deploy.sh sources this file. Encode: @ → %40, # → %23, : → %3A, / → %2F.
# The single quotes are required for the same reason.
REDIS_URL='redis://:<URL_ENCODED_REDIS_PASSWORD>@127.0.0.1:6379/3'
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_WORKER_CONCURRENCY=2


# ── Telephony (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=<COPY_FROM_LOCAL>
TWILIO_AUTH_TOKEN=<COPY_FROM_LOCAL>
TWILIO_FROM_NUMBER=<YOUR_TWILIO_NUMBER_E164>

# ── Telephony (Plivo — India) ────────────────────────────────────────────────
# Twilio cannot legally carry Indian domestic traffic, so India routes through
# Plivo. This VPS is also the reason India works at all: both call legs and the
# media socket must stay in India, so PUBLIC_BACKEND_WS_URL (above) has to
# point at India-hosted infra. Full setup: backend/docs/PLIVO_INTEGRATION.md
#
# The account MUST be registered in Plivo's INDIA data region — chosen at
# signup and not changeable afterwards. As a RESELLER, a separate compliance
# application is filed per end customer before that customer can hold a number.
#
# MAIN account credentials. Subaccount credentials can place calls but cannot
# create subaccounts, rent numbers, or file compliance applications.
PLIVO_AUTH_ID=<COPY_FROM_PLIVO_CONSOLE>
PLIVO_AUTH_TOKEN=<COPY_FROM_PLIVO_CONSOLE>
PLIVO_FROM_NUMBER=<A_PLIVO_NUMBER_YOU_HOLD_E164>
# Leave BLANK to derive https://<this host>/api/v1/plivo/answer from
# PUBLIC_BACKEND_WS_URL. Set only if the public host differs.
PLIVO_ANSWER_URL=
# Compliance status callbacks. Must match what is registered with Plivo
# byte-for-byte — the V3 signature is computed over this exact string.
PLIVO_WEBHOOK_URL=
# FALLBACK voice application. Each workspace's subaccount gets its own, created
# on its first rent; this covers a deployment with no public answer URL, and
# numbers rented before that existed.
PLIVO_VOICE_APP_ID=
# Diagnostic only. 'true' disables signature checking on the answer/hangup
# callbacks; never leave it on.
PLIVO_SKIP_SIGNATURE_CHECK=

# May a client rent a number themselves? Renting debits their wallet before it
# asks the carrier for anything, so it is safe in principle — but this path has
# never run against a live Plivo account, and being wrong spends OUR money.
# Leave unset until one rent has succeeded: a client's pick then becomes a
# request that Admin -> Numbers & Carrier fulfils through the same code.
PLIVO_SELF_SERVE_RENT=
# Set to 'false' to stop the daily carrier-usage reconciliation sweep. It is
# read-only against Plivo and never adjusts a wallet.
PLIVO_RECONCILIATION_ENABLED=

# Carrier used when a caller ID has no VoiceNumber row. Keep at TWILIO: India
# moves per-number, not by flipping this.
TELEPHONY_PROVIDER_DEFAULT=TWILIO


# ── LLM providers ────────────────────────────────────────────────────────────
# Groq handles live voice turns when set (much lower TTFT); chat keeps its
# configured provider.
GROQ_API_KEY=<COPY_FROM_LOCAL>
GROQ_MODEL=llama-3.3-70b-versatile

# WARNING: the Gemini key you have locally is free tier — 20 requests per DAY.
# It will rate-limit almost immediately in production. Use a paid key or rely
# on Groq for voice.
GEMINI_API_KEY=<COPY_FROM_LOCAL>

SARVAM_API_KEY=<COPY_FROM_LOCAL>
XAI_API_KEY=<COPY_FROM_LOCAL>
XAI_VOICE_MODEL=grok-voice-latest


# ── Speech (STT / TTS) ───────────────────────────────────────────────────────
DEEPGRAM_API_KEY=<COPY_FROM_LOCAL>
DEEPGRAM_MODEL=nova-2
# Phone calls only. A carrier media stream is 8kHz G.711 — narrowband and codec
# damaged — and the wideband model above transcribes it measurably worse. That
# is a LATENCY cost, not just a quality one: a weaker transcript ends on a
# dangling token more often, and looksUnfinished() answers a dangling tail by
# waiting out DEEPGRAM_UNFINISHED_GRACE_MS (1100ms) instead of the normal 400ms
# grace. Applied automatically to mulaw sessions; never to language=multi, which
# has no phonecall variant.
DEEPGRAM_MODEL_PHONE=nova-2-phonecall
# Endpointing/grace live with the turn-end profile further down — see the
# "Turn-end timing" block and why setting them here achieves nothing.
# UTTERANCE_END is different: it is read straight from env on every session and
# is not profile-gated, so it stays.
DEEPGRAM_UTTERANCE_END_MS=1000

ELEVENLABS_API_KEY=<COPY_FROM_LOCAL>
# WAS eleven_multilingual_v2, which is also the code's fallback
# (voice/providers/elevenlabs.provider.js) — i.e. the slowest tier by both
# config AND default. multilingual_v2 is the quality model; turbo is the one
# built for realtime, and it is what the dev box has been running all along, so
# a phone call measured here was being compared against a faster web call.
# eleven_flash_v2_5 is faster still if you will trade more warmth for it.
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# 0-3, default 2. 3 is ElevenLabs' most aggressive latency mode; it flattens
# intonation slightly, which on a G.711 phone line is largely inaudible anyway.
ELEVENLABS_STREAMING_LATENCY=3
ELEVENLABS_CONVAI_AGENT_ID=<COPY_FROM_LOCAL>

FISH_API_KEY=<COPY_FROM_LOCAL>
# DO NOT copy a "-free" model id from the dev box (it currently runs
# s2.1-pro-free). canStreamTokens() in fishaudio.provider.js turns token
# streaming OFF for a -free id, which silently drops every Fish voice from the
# socket path onto per-sentence HTTP — a large latency regression with nothing
# in the logs naming it.
FISH_TTS_MODEL=s2.1-pro
FISH_TTS_WS_MODEL=s2-pro
FISH_TTS_FORMAT=mp3
FISH_VOICE_LANGUAGES=en,hi

CARTESIA_API_KEY=<COPY_FROM_LOCAL>


# ── Voice latency pipeline ───────────────────────────────────────────────────
# Re-measure these after the first deploy rather than trusting the defaults:
# the box has 2 vCPUs shared with 17 other processes, so real turn latency here
# will not match what you measured locally.
VOICE_SENTENCE_SPLIT=true
VOICE_TTS_OVERLAP=true
# How long a turn may be silent before the cached "mm-hmm" plays. This does not
# make the reply arrive sooner — it makes the wait audible sooner, which is the
# half of latency the caller actually experiences.
VOICE_FILLER_DELAY_MS=250
VOICE_MAX_BREAK_MS=400
VOICE_MAX_BREAKS_PER_REPLY=1
STT_ECHO_SIMILARITY=0.75
STT_ECHO_MIN_CHARS=8

# ── Prompt size — THE regression lever ───────────────────────────────────────
# agentRuntime.service.js caps how much knowledge base is pasted into every
# prompt. Those caps were RAISED from 6k/24k to 48k/96k to fix recall, and the
# file measures the cost of exactly that: 12k chars -> 1399ms TTFT, 48k chars ->
# 3738ms. Nothing sets them, so an agent with a knowledge base has been paying
# up to ~2.3s of extra prefill on the first turn of every call — on the phone
# and the browser alike. It is invisible until someone adds KB files, which is
# why a pipeline that was fast when telephony was first wired up is not now.
#
# Implicit caching absorbs this from turn 2 onward, so the symptom is "the first
# reply is slow". KB_VOICE_CHARS is the voice-only slice: lowering it leaves the
# text-chat path at full recall. Raise it back if agents start saying they do
# not know documented facts — this is a real trade, not a free win.
KB_VOICE_CHARS=12000
KB_PER_FILE_CHARS=12000
KB_TOTAL_CHARS=24000

# ── Turn-end timing ──────────────────────────────────────────────────────────
# DELIBERATELY NOT SET. These apply ONLY to agents that have not chosen a
# response speed in the editor (turnEndProfile.js: "an explicit choice in the
# editor wins over the environment"), and every value below was identical to the
# Balanced profile they would have got anyway — so they read like live tuning
# knobs while doing nothing at all. Set the profile on the agent instead:
# Fast = 250/250/800/80, Balanced = 300/400/1100/150, Patient = 400/700/1600/300.
# DEEPGRAM_ENDPOINTING_MS=300
# DEEPGRAM_UNFINISHED_GRACE_MS=1100


# ── Billing (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=<COPY_FROM_LOCAL>
RAZORPAY_KEY_SECRET=<COPY_FROM_LOCAL>
# A DISTINCT value from KEY_SECRET, set under Razorpay → Settings → Webhooks
# with the endpoint https://spandan.mannmate.com/api/v1/billing/razorpay/webhook
# The webhook fails CLOSED when unset: top-ups are rejected, not silently
# trusted.
RAZORPAY_WEBHOOK_SECRET=<FROM_RAZORPAY_WEBHOOK_SETTINGS>

BILLING_CURRENCY=INR
FX_USD_TO_INR=96
BILLING_INCREMENT_SEC=60
FALLBACK_PER_MINUTE_USD=0.12
MIN_TOPUP_CENTS=10000
MAX_TOPUP_CENTS=5000000
BILLING_TAX_PERCENT=0


# ── Meta / WhatsApp ──────────────────────────────────────────────────────────
META_APP_ID=<COPY_FROM_LOCAL>
META_APP_SECRET=<COPY_FROM_LOCAL>
META_BUSINESS_ID=<COPY_FROM_LOCAL>
META_WABA_ID=<COPY_FROM_LOCAL>
META_SYSTEM_USER_ID=<COPY_FROM_LOCAL>
META_SYSTEM_USER_TOKEN=<COPY_FROM_LOCAL>
META_WEBHOOK_VERIFY_TOKEN=<COPY_FROM_LOCAL>
META_API_VERSION=v19.0
META_DISPLAY_NAME=Whabridge


# ── Google OAuth ─────────────────────────────────────────────────────────────
# These exact URIs must be re-registered in Google Cloud Console. The
# localhost:4000 values from your local .env will be rejected.
GOOGLE_CLIENT_ID=<COPY_FROM_LOCAL>
GOOGLE_CLIENT_SECRET=<COPY_FROM_LOCAL>
GOOGLE_REDIRECT_URI=https://spandan.mannmate.com/api/v1/integrations/google_calendar/callback
GOOGLE_AUTH_REDIRECT_URI=https://spandan.mannmate.com/api/v1/auth/google/callback


# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# [OPTIONAL] Without it, signup verification and password-reset mails are never
# delivered — users can register but never confirm.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME='Voice AI Platform'


# ── Behaviour ────────────────────────────────────────────────────────────────
# The VPS clock is UTC. A caller saying "3 PM" means 3 PM where THEY are, so
# this must be set explicitly rather than inherited from the host zone.
APPOINTMENT_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
STALE_CALL_MS=7200000
LOG_LEVEL=info

# ── TRAI / DLT compliance (India outbound) ─────────────────────────────────
# off | warn | enforce. Keep on "warn" until every active workspace has been
# onboarded: "enforce" refuses Indian outbound calls from any workspace without
# a verified DLT Principal Entity ID. Non-Indian caller IDs are never gated.
DLT_COMPLIANCE_MODE=warn
# Our telemarketer (aggregator) ID, which each client declares in their own DLT
# portal to bind their Principal Entity to our infrastructure. Leave blank until
# it is issued.
PLATFORM_TM_ID=
