# ─────────────────────────────────────────────────────────────────────────────
# Render production environment — TEMPLATE
#
# HOW TO USE: Render dashboard -> your service -> Environment -> "Add from .env"
# and paste this file, then replace every <PLACEHOLDER>. Values already filled
# in are safe defaults and can be pasted as-is.
#
# This file is a TEMPLATE and is committed. NEVER paste real keys into it.
# Real values live in Render's dashboard and in your local backend/.env only.
# (backend/.env.production is gitignored if you prefer to keep a filled copy
# on disk — but the dashboard is the source of truth.)
#
# Tiers below are marked:
#   [REQUIRED]  — src/config/env.js throws on boot without it
#   [NEEDED]    — a feature is silently dead without it
#   [OPTIONAL]  — has a working default
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# DO NOT SET PORT. Render injects it (10000) and server.js:120 reads it.
# Setting it here overrides Render's value and the health check will fail.


# ── Database ─────────────────────────────────────────────────────────────────
# [REQUIRED] Supabase POOLED connection (PgBouncer, port 6543). env.js:15
# validates this is a postgresql:// URL. The pgbouncer/connection_limit params
# are not optional: Prisma opens a pool per instance and will otherwise exhaust
# Supabase's connection cap.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# [REQUIRED] Non-pooled DIRECT connection, port 5432. prisma/schema.prisma:8
# declares directUrl and migrations run through it — PgBouncer cannot execute
# DDL in transaction mode, so a migration against the 6543 URL fails.
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres


# ── Auth / crypto ────────────────────────────────────────────────────────────
# [REQUIRED] Any 32+ char random strings. Changing them only logs everyone out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<GENERATE_32_PLUS_CHARS>
JWT_REFRESH_SECRET=<GENERATE_32_PLUS_CHARS_DIFFERENT>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# [REQUIRED] COPY THE EXISTING VALUE from your local backend/.env. Do NOT
# generate a new one: this decrypts integration tokens already stored in the
# live Supabase DB, and a fresh key makes every saved OAuth credential
# permanently unreadable.
ENCRYPTION_KEY=<COPY_EXACTLY_FROM_LOCAL_backend/.env>

BCRYPT_SALT_ROUNDS=12

# [NEEDED] Your login email. Without it nobody can reach /admin.
SUPER_ADMIN_EMAIL=<YOUR_LOGIN_EMAIL>


# ── Self-referencing URLs ────────────────────────────────────────────────────
# Fill these AFTER the first deploy, once Render assigns the host.
#
# [NEEDED] CLIENT_URL is the CORS allowlist (app.js:13). In production the
# localhost fallbacks are excluded, so an empty value means every API call from
# your own page is rejected. Comma-separated for multiple origins.
CLIENT_URL=https://<YOUR_SERVICE>.onrender.com

# [NEEDED for phone calls] The wss:// origin Twilio dials for Media Streams.
# Unset, bundled-engine phone calls degrade to greeting-only.
PUBLIC_BACKEND_WS_URL=wss://<YOUR_SERVICE>.onrender.com

CHATFLOW_PRO_URL=https://<YOUR_SERVICE>.onrender.com


# ── Uploads ──────────────────────────────────────────────────────────────────
# FREE TIER: leave as "uploads". Free instances have no persistent disk, so KB
# files, cloned voices and recordings are wiped on every deploy and spin-down.
# PAID TIER: attach a disk mounted at /var/data and change this to
# /var/data/uploads.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
JSON_BODY_LIMIT=2mb


# ── Queues ───────────────────────────────────────────────────────────────────
# FREE TIER: leave EMPTY. server.js:62 then logs "Campaign worker skipped" and
# campaigns dispatch in-process — the same behaviour you have locally. Queued
# jobs are lost on restart.
# PAID: a Render Key Value internal connection string. Set its maxmemory policy
# to noeviction, or BullMQ silently loses jobs.
REDIS_URL=
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_WORKER_CONCURRENCY=2


# ── Telephony (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=<COPY_FROM_LOCAL>
TWILIO_AUTH_TOKEN=<COPY_FROM_LOCAL>
# Not set in your local .env — outbound calls need it.
TWILIO_FROM_NUMBER=<YOUR_TWILIO_NUMBER_E164>


# ── LLM providers ────────────────────────────────────────────────────────────
# GROQ handles live voice turns when set (much faster TTFT); chat keeps its
# configured provider.
GROQ_API_KEY=<COPY_FROM_LOCAL>
GROQ_MODEL=llama-3.3-70b-versatile

# NOTE: your GEMINI key is on the free tier — 20 requests/DAY. It will rate-limit
# almost immediately in a deployed environment. Put a paid key here or rely on
# Groq for voice.
GEMINI_API_KEY=<COPY_FROM_LOCAL>

SARVAM_API_KEY=<COPY_FROM_LOCAL>
XAI_API_KEY=<COPY_FROM_LOCAL>
XAI_VOICE_MODEL=grok-voice-latest


# ── Speech (STT / TTS) ───────────────────────────────────────────────────────
DEEPGRAM_API_KEY=<COPY_FROM_LOCAL>
DEEPGRAM_MODEL=nova-2
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000

ELEVENLABS_API_KEY=<COPY_FROM_LOCAL>
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_CONVAI_AGENT_ID=<COPY_FROM_LOCAL>

FISH_API_KEY=<COPY_FROM_LOCAL>
FISH_TTS_MODEL=s2.1-pro
FISH_TTS_WS_MODEL=s2-pro
FISH_TTS_FORMAT=mp3
FISH_VOICE_LANGUAGES=en,hi

CARTESIA_API_KEY=<COPY_FROM_LOCAL>


# ── Voice latency pipeline ───────────────────────────────────────────────────
# On the FREE tier (0.1 CPU) these numbers are not meaningful — the instance is
# too slow for the measurements to reflect real latency. Do not tune here.
VOICE_SENTENCE_SPLIT=true
VOICE_TTS_OVERLAP=true
VOICE_FILLER_DELAY_MS=400
VOICE_MAX_BREAK_MS=700
VOICE_MAX_BREAKS_PER_REPLY=2
DEEPGRAM_UNFINISHED_GRACE_MS=1100
STT_ECHO_SIMILARITY=0.75
STT_ECHO_MIN_CHARS=8


# ── Billing (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=<COPY_FROM_LOCAL>
RAZORPAY_KEY_SECRET=<COPY_FROM_LOCAL>
# NOT set in your local .env, and NOT the same value as KEY_SECRET. Set it under
# Razorpay -> Settings -> Webhooks. The webhook fails CLOSED when unset, so
# every wallet top-up is rejected rather than silently trusted.
RAZORPAY_WEBHOOK_SECRET=<FROM_RAZORPAY_WEBHOOK_SETTINGS>

BILLING_CURRENCY=INR
FX_USD_TO_INR=96
BILLING_INCREMENT_SEC=60
FALLBACK_PER_MINUTE_USD=0.12
MIN_TOPUP_CENTS=10000
MAX_TOPUP_CENTS=5000000
BILLING_TAX_PERCENT=0


# ── Meta / WhatsApp ──────────────────────────────────────────────────────────
META_APP_ID=<COPY_FROM_LOCAL>
META_APP_SECRET=<COPY_FROM_LOCAL>
META_BUSINESS_ID=<COPY_FROM_LOCAL>
META_WABA_ID=<COPY_FROM_LOCAL>
META_SYSTEM_USER_ID=<COPY_FROM_LOCAL>
META_SYSTEM_USER_TOKEN=<COPY_FROM_LOCAL>
META_WEBHOOK_VERIFY_TOKEN=<COPY_FROM_LOCAL>
META_API_VERSION=v19.0
META_DISPLAY_NAME=Whabridge


# ── Google OAuth ─────────────────────────────────────────────────────────────
# The redirect URI must be re-registered in Google Cloud Console against the
# Render host — the localhost:4000 value in your local .env will be rejected.
GOOGLE_CLIENT_ID=<COPY_FROM_LOCAL>
GOOGLE_CLIENT_SECRET=<COPY_FROM_LOCAL>
GOOGLE_REDIRECT_URI=https://<YOUR_SERVICE>.onrender.com/api/v1/integrations/google_calendar/callback
GOOGLE_AUTH_REDIRECT_URI=https://<YOUR_SERVICE>.onrender.com/api/v1/auth/google/callback


# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# [OPTIONAL] Not configured locally. Without it, signup verification and
# password-reset emails are never delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Voice AI Platform


# ── Behaviour ────────────────────────────────────────────────────────────────
# Must not be left to the host zone: a caller saying "3 PM" means 3 PM where
# THEY are, and Render's containers run UTC.
APPOINTMENT_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
STALE_CALL_MS=7200000
LOG_LEVEL=info

# FREE TIER ONLY: uncomment if the build dies with "JavaScript heap out of
# memory". 512 MB is tight for `tsc && vite build` over this dependency tree;
# this caps V8's heap below the container limit so it GCs instead of being
# OOM-killed.
# NODE_OPTIONS=--max-old-space-size=460
