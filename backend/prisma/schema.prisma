generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model VoiceProvider {
  id           String    @id @default(cuid())
  name         String    @unique
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  voices       Voice[]

  @@index([name])
}

model Voice {
  id              String        @id @default(cuid())
  providerId      String
  providerVoiceId String
  name            String
  language        String?
  accent          String?
  gender          String?
  category        String?
  workspaceId     String?
  metadata        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  provider        VoiceProvider @relation(fields: [providerId], references: [id])

  @@unique([providerId, providerVoiceId])
  @@index([workspaceId, category])
}

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  passwordHash          String?
  googleId              String?           @unique
  name                  String
  avatarUrl             String?
  banned                Boolean           @default(false)
  bannedAt              DateTime?
  bannedReason          String?
  planName              String            @default("Free")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  mobile                String?           @unique
  assignedConversations Conversation[]
  sentMessages          Message[]
  refreshTokens         RefreshToken[]
  memberships           WorkspaceMember[]
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  logoUrl             String?
  metaWabaId          String?
  metaAccessToken     String?
  metaBusinessId      String?
  planName            String               @default("Starter")
  wabaId              String?
  numberAssigned      Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  agents              Agent[]
  apiKeys             ApiKey[]
  automationFlow      AutomationFlow?
  campaigns           Campaign[]
  contacts            Contact[]
  conversations       Conversation[]
  customApiConfigs    CustomApiConfig[]
  integrations        Integration[]
  integrationLogs     IntegrationLog[]
  integrationSettings IntegrationSetting[]
  integrationTokens   IntegrationToken[]
  invoices            Invoice[]
  paymentOrders       PaymentOrder[]
  subscription        Subscription?
  keywordTriggers     KeywordTrigger[]
  messages            Message[]
  notifications       Notification[]
  numberPool          NumberPool?
  oauthSessions       OAuthSession[]
  syncJobs            SyncJob[]
  templates           Template[]
  webhookConfig       WebhookConfig?
  webhookEvents       WebhookEvent[]
  whatsappNumbers     WhatsappNumber[]
  invites             WorkspaceInvite[]
  members             WorkspaceMember[]
  settings            WorkspaceSettings?
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("Member")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  workspaceId String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String    @default("Member")
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

model WhatsappNumber {
  id                String         @id @default(cuid())
  workspaceId       String
  phoneNumber       String
  displayName       String
  category          String?
  website           String?
  description       String?
  logoUrl           String?
  metaPhoneNumberId String?
  status            String         @default("Pending")
  wabaId            String?
  accessToken       String?
  qualityRating     String?
  messagingLimit    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  campaigns         Campaign[]
  conversations     Conversation[]
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phoneNumber])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  environment String    @default("live")
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WebhookConfig {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  url              String
  secret           String
  subscribedEvents String    @default("")
  isActive         Boolean   @default(true)
  lastPingAt       DateTime?
  lastPingStatus   Int?
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Template {
  id              String     @id @default(cuid())
  workspaceId     String
  metaTemplateId  String?
  name            String
  category        String     @default("MARKETING")
  language        String     @default("en")
  bodyText        String
  headerText      String?
  footerText      String?
  buttons         String?    @default("")
  status          String     @default("PENDING")
  rejectionReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  campaigns       Campaign[]
  messages        Message[]
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name, language])
}

model Contact {
  id            String              @id @default(cuid())
  workspaceId   String
  phoneNumber   String
  name          String?
  email         String?
  tags          String              @default("")
  customFields  String?             @default("")
  optedOut      Boolean             @default(false)
  optedOutAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  campaigns     CampaignRecipient[]
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, phoneNumber])
}

model Campaign {
  id               String              @id @default(cuid())
  workspaceId      String
  name             String
  templateId       String
  whatsappNumberId String
  variableMapping  String?             @default("{}")
  botId            String?
  phoneNumbers     Json?
  csvFileName      String?
  fromNumber       String?
  progress         Int                 @default(0)
  concurrentCalls  Int                 @default(1)
  status           String              @default("DRAFT")
  scheduledAt      DateTime?
  launchedAt       DateTime?
  completedAt      DateTime?
  totalContacts    Int                 @default(0)
  sent             Int                 @default(0)
  delivered        Int                 @default(0)
  read             Int                 @default(0)
  failed           Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  template         Template            @relation(fields: [templateId], references: [id])
  whatsappNumber   WhatsappNumber      @relation(fields: [whatsappNumberId], references: [id])
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients       CampaignRecipient[]
}

model CampaignRecipient {
  id            String    @id @default(cuid())
  campaignId    String
  contactId     String
  metaMessageId String?
  status        String    @default("pending")
  failureReason String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
}

model Conversation {
  id               String         @id @default(cuid())
  workspaceId      String
  contactId        String
  whatsappNumberId String
  assignedAgentId  String?
  status           String         @default("OPEN")
  label            String?
  botEnabled       Boolean        @default(true)
  sessionExpiresAt DateTime?
  lastMessageAt    DateTime?
  unreadCount      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  assignedAgent    User?          @relation(fields: [assignedAgentId], references: [id])
  contact          Contact        @relation(fields: [contactId], references: [id])
  whatsappNumber   WhatsappNumber @relation(fields: [whatsappNumberId], references: [id])
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages         Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  workspaceId    String
  metaMessageId  String?      @unique
  direction      String       @default("OUTBOUND")
  type           String       @default("TEXT")
  body           String?
  mediaUrl       String?
  mediaCaption   String?
  templateId     String?
  templateVars   String       @default("{}")
  status         String       @default("sent")
  senderUserId   String?
  sentAt         DateTime     @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User?        @relation(fields: [senderUserId], references: [id])
  template       Template?    @relation(fields: [templateId], references: [id])
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model KeywordTrigger {
  id          String    @id @default(cuid())
  workspaceId String
  keyword     String
  replyText   String
  isActive    Boolean   @default(true)
  matchExact  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, keyword])
}

model AutomationFlow {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  flowJson    String    @default("{}")
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceSettings {
  id                  String    @id @default(cuid())
  workspaceId         String    @unique
  timezone            String    @default("UTC")
  businessHoursJson   String?   @default("{}")
  notifyOnNewConv     Boolean   @default(true)
  notifyOnOptOut      Boolean   @default(true)
  notifyOnCampaignEnd Boolean   @default(true)
  notifyOnHighOptOut  Boolean   @default(false)
  notifyOnRateLimit   Boolean   @default(true)
  updatedAt           DateTime  @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String    @id @default(cuid())
  workspaceId String
  planName    String
  amountCents Int
  currency    String    @default("INR")
  status      String    @default("Paid")
  invoiceDate DateTime
  pdfUrl      String?
  createdAt   DateTime  @default(now())
  // Human-facing sequential document number (INV-2026-000123). Unique so a
  // retried generation cannot mint two documents for the same payment.
  number      String?   @unique
  // topup | subscription
  type        String    @default("topup")
  subtotalCents Int     @default(0)
  taxCents      Int     @default(0)
  // The payment this invoice documents. Unique: one invoice per payment, which
  // is what makes generation safe to retry.
  paymentOrderId String? @unique
  periodStart DateTime?
  periodEnd   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, invoiceDate])
}

model NumberPool {
  id            String     @id @default(cuid())
  phoneNumber   String     @unique
  phoneNumberId String     @unique
  wabaId        String
  accessToken   String
  displayName   String?
  status        String     @default("AVAILABLE")
  assignedTo    String?    @unique
  registeredAt  DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workspace     Workspace? @relation(fields: [assignedTo], references: [id])
}

model Agent {
  id                   String    @id @default(cuid())
  workspaceId          String
  name                 String
  welcomeMessage       String
  aiModel              String
  voice                String
  transcription        String    @default("Azure")
  languages            String    @default("[]")
  flowItems            String?   @default("{}")
  maxDuration          Int       @default(30)
  silenceTimeout       Int       @default(5)
  dynamicEnabled       Boolean   @default(true)
  interruptibleEnabled Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  settings             String    @default("{}")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Per-agent interaction history shown in Edit Agent → Recent Calls.
// Every test session is logged: text chats (CHAT), browser voice calls
// (WEB_CALL, with a full-call recording) and phone test calls (PHONE_CALL).
model AgentCallLog {
  id            String    @id @default(cuid())
  workspaceId   String
  agentId       String
  type          String    @default("CHAT") // CHAT | WEB_CALL | PHONE_CALL
  status        String    @default("COMPLETED") // IN_PROGRESS | COMPLETED | INITIATED | FAILED
  transcript    String    @default("[]") // JSON [{ role, content }]
  durationSec   Int       @default(0)
  recordingPath String?
  recordingMime String?
  phoneNumber   String?
  extractedData String    @default("{}") // JSON: configured variables, values, evidence, model metadata
  extractionStatus String @default("PENDING") // PENDING | PROCESSING | COMPLETED | SKIPPED | FAILED
  extractionError String?
  extractedAt   DateTime?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── Billing (BUG-002) ──────────────────────────────────────────────────────
  // PENDING | BILLED | SKIPPED | FAILED. Guards against double-charging: all
  // three call-end paths converge on settleCall(), which only charges a call
  // still in PENDING.
  billingStatus String   @default("PENDING")
  billedCents   Int      @default(0)
  billedAt      DateTime?
  // The customer-facing rate actually applied, snapshotted so a later plan or
  // FX change cannot retroactively alter what this call cost.
  ratePerMinuteCents Int?
  billedMinutes Float    @default(0)
  // Measured provider COGS in micro-USD (millionths), RECORDED not charged —
  // the customer pays the rate card. This is what makes per-call margin
  // reportable instead of guessed.
  actualCostMicroUsd Int?

  @@index([workspaceId, agentId, startedAt])
  @@index([billingStatus, endedAt])
}

model Integration {
  id              String              @id @default(cuid())
  workspaceId     String
  provider        String
  name            String
  status          String              @default("disconnected")
  connected       Boolean             @default(false)
  accountId       String?
  accountLabel    String?
  lastSyncAt      DateTime?
  lastError       String?
  tokenExpiresAt  DateTime?
  webhookStatus   String              @default("not_configured")
  webhookEnabled  Boolean             @default(false)
  lastSyncedCount Int                 @default(0)
  metadata        String?             @default("{}")
  settingsJson    String              @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs            IntegrationLog[]
  settings        IntegrationSetting?
  token           IntegrationToken?
  oauthSessions   OAuthSession[]
  syncJobs        SyncJob[]
  webhookEvents   WebhookEvent[]

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
}

model IntegrationToken {
  id                 String      @id @default(cuid())
  integrationId      String      @unique
  workspaceId        String
  provider           String
  accessTokenCipher  String
  refreshTokenCipher String?
  tokenType          String?
  scopes             String      @default("")
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  integration        Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace          Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider])
}

model IntegrationLog {
  id            String       @id @default(cuid())
  workspaceId   String
  integrationId String?
  provider      String
  level         String       @default("info")
  event         String
  message       String
  status        String?
  metadata      String?      @default("{}")
  createdAt     DateTime     @default(now())
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider, createdAt])
}

model OAuthSession {
  id            String       @id @default(cuid())
  workspaceId   String
  integrationId String?
  provider      String
  userId        String?
  state         String       @unique
  codeVerifier  String?
  redirectUri   String?
  expiresAt     DateTime
  consumedAt    DateTime?
  metadata      String?      @default("{}")
  createdAt     DateTime     @default(now())
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider])
}

model WebhookEvent {
  id               String       @id @default(cuid())
  workspaceId      String
  integrationId    String?
  provider         String
  providerEventId  String?
  eventType        String
  payload          String
  headers          String?      @default("{}")
  signatureValid   Boolean      @default(true)
  processingStatus String       @default("received")
  processedAt      DateTime?
  error            String?
  createdAt        DateTime     @default(now())
  integration      Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider, createdAt])
}

model SyncJob {
  id            String       @id @default(cuid())
  workspaceId   String
  integrationId String?
  provider      String
  jobType       String       @default("manual")
  status        String       @default("queued")
  attempts      Int          @default(0)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  error         String?
  metadata      String?      @default("{}")
  createdAt     DateTime     @default(now())
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider, status])
}

model IntegrationSetting {
  id               String      @id @default(cuid())
  workspaceId      String
  integrationId    String      @unique
  provider         String
  settingsJson     String      @default("{}")
  enabled          Boolean     @default(true)
  webhookEnabled   Boolean     @default(false)
  selectedChannels String?     @default("[]")
  lastValidatedAt  DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  integration      Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider])
}

model CustomApiConfig {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  endpointUrl     String
  method          String    @default("GET")
  authType        String    @default("none")
  authValueCipher String?
  headersJson     String    @default("{}")
  queryParamsJson String    @default("{}")
  bodyTemplate    String?
  enabled         Boolean   @default(true)
  lastTestAt      DateTime?
  lastTestStatus  Int?
  lastTestError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, name])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  message     String
  type        String    @default("INFO")
  read        Boolean   @default(false)
  details     String?
  actionText  String?
  actionLink  String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, read, createdAt])
}

model ContactSubmission {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  callVolume String
  helpWith   String
  useCase    String
  heardAbout String?
  createdAt  DateTime @default(now())
}

model AppointmentBooking {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  projectType String
  role        String
  reason      String
  callVolume  String
  userType    String
  industry    String
  useCase     String
  createdAt   DateTime @default(now())
}

model ReportIssue {
  id            String   @id @default(cuid())
  issueTitle    String
  description   String
  screenshotUrl String?
  createdAt     DateTime @default(now())
}

model VerificationToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String
  purpose    String
  payload    String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model KbFile {
  id           String   @id @default(cuid())
  workspaceId  String
  uploadedById String
  agentId      String?
  fileName     String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  textContent  String?
  createdAt    DateTime @default(now())

  @@index([workspaceId])
  @@index([workspaceId, agentId])
}

model Plan {
  id              String   @id @default(cuid())
  name            String   @unique
  priceUsd        Float
  perMinuteUsd    Float
  // INR is the price of record for this deployment. Nullable so a plan created
  // before this existed still works: money.js falls back to priceUsd x FX.
  // Keeping a real INR price (rather than deriving it) means a change to
  // FX_USD_TO_INR cannot silently reprice the product, and lets an admin set
  // round price points instead of 8,544.
  priceInr        Float?
  perMinuteInr    Float?
  // Mirrored Razorpay plan ids, kept per MODE. Test and live are separate
  // datasets — a plan created with rzp_test_ keys does not exist in live mode,
  // so one shared column would carry a test id into production and fail there.
  razorpayPlanIdTest String?
  razorpayPlanIdLive String?
  includedMinutes Int
  kbStorageMb     Int      @default(100)
  // Enforceable limits. `features` is a marketing string list ("3 agents") and
  // was never machine-readable, so nothing could actually be gated on it.
  // These are the numbers assertCanStartCall() and agent creation check.
  maxAgents          Int   @default(1)
  maxConcurrentCalls Int   @default(1)
  features        String
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subscriptions   Subscription[]
}

// Prepaid balance for one workspace, held in MINOR UNITS of `currency`
// (paise for INR). Never mutated directly — every change goes through
// applyWalletTransaction() in services/billing.service.js so that the balance
// and the ledger can never disagree.
model Wallet {
  id           String              @id @default(cuid())
  workspaceId  String              @unique
  balanceCents Int                 @default(0)
  // INR because that is what Razorpay settles in. Plans are catalogued in USD
  // and converted at charge time with the FX rate recorded on the transaction,
  // so a historical charge stays reproducible even after the rate moves.
  currency     String              @default("INR")
  // How far below zero this wallet may go before new calls are blocked.
  // 0 = hard stop at zero (the default). Non-zero lets an enterprise account
  // run on invoice terms without being cut off mid-conversation.
  overdraftLimitCents Int          @default(0)
  // Set when a low-balance warning was last sent, so the notifier does not
  // re-send on every single call once the balance is low.
  lowBalanceNotifiedAt DateTime?
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

// Append-only ledger. One row per balance mutation, and the ONLY audit record
// of money movement — nothing else is authoritative.
model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  // Signed: positive credits (top-up, refund, admin), negative debits (usage,
  // subscription). Summing this column for a wallet must always equal its
  // balanceCents; that invariant is asserted in the billing tests.
  amountCents Int
  // Balance immediately AFTER this row was applied. Lets an auditor verify the
  // running balance without replaying the whole ledger, and makes an
  // out-of-order or lost write visible instead of silent.
  balanceAfterCents Int   @default(0)
  currency    String   @default("INR")
  // topup | usage | admin_credit | refund | subscription | adjustment
  type        String
  // THE double-charge guard. A retried Razorpay webhook, a double-fired
  // call-end event, or a client PATCH replay all carry the same key, and the
  // unique constraint makes the second write fail instead of charging twice.
  // Nullable because ad-hoc admin adjustments have no natural key, and
  // Postgres permits many NULLs under a UNIQUE index.
  idempotencyKey String? @unique
  note        String?
  // JSON: callLogId, durationSec, rate applied, provider ids — whatever is
  // needed to explain this line item back to a customer.
  metadata    String   @default("{}")
  // FX rate used when converting a USD-denominated plan rate into the wallet's
  // currency. Recorded per row so an old charge can be re-derived exactly.
  fxRateUsdToInr Float?
  createdById String?
  createdAt   DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([type, createdAt])
}

// A workspace's current plan and billing period. Separate from
// Workspace.planName (a display string) because enforcement and renewal need
// real period boundaries and usage counters, not a label.
model Subscription {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  planId             String
  planName           String
  // active | past_due | cancelled | expired
  status             String    @default("active")
  billingPeriod      String    @default("monthly") // monthly | yearly
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  // Downgrades and cancellations take effect at the period boundary, not
  // immediately — the customer already paid for this period.
  cancelAtPeriodEnd  Boolean   @default(false)
  pendingPlanId      String?
  cancelledAt        DateTime?
  // Included minutes for the CURRENT period, reset on renewal. Usage beyond
  // this draws down the wallet.
  minutesIncluded    Int       @default(0)
  minutesUsed        Float     @default(0)
  razorpaySubscriptionId String? @unique
  // Renews itself on a saved card. False = the period simply lapses, which is
  // the pre-existing wallet-funded behaviour.
  autoRenew          Boolean   @default(false)
  // Last gateway charge applied, so a replayed subscription.charged webhook for
  // an already-processed cycle is recognisable.
  lastChargeId       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan               Plan      @relation(fields: [planId], references: [id])

  @@index([status, currentPeriodEnd])
  @@index([autoRenew, status])
}

// A payment initiated with the gateway. Created BEFORE the customer pays, so a
// webhook arriving for an unknown order is detectable as fraud/misroute rather
// than silently crediting a wallet.
model PaymentOrder {
  id                String    @id @default(cuid())
  workspaceId       String
  provider          String    @default("razorpay")
  providerOrderId   String    @unique
  providerPaymentId String?   @unique
  amountCents       Int
  currency          String    @default("INR")
  purpose           String    @default("topup") // topup | subscription
  planId            String?
  // created | paid | failed | refunded
  status            String    @default("created")
  notes             String    @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  paidAt            DateTime?
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

model documents {
  id          String   @id
  user_id     String
  file_name   String
  file_url    String
  uploaded_at DateTime @default(now())
}

// ─── ADMIN CONSOLE ────────────────────────────────────────────────────────────

/// Append-only record of every mutating action taken in the /admin panel.
///
/// Deliberately NOT related to User with a foreign key. An audit log whose rows
/// vanish when the actor is deleted is worthless precisely in the case you most
/// need it — "who deleted this account, and who deleted them?". `actorId` is a
/// bare string and `actorEmail` is denormalised at write time, so the trail
/// survives deletion of both actor and target.
///
/// `before`/`after` hold JSON snapshots as String, matching how every other
/// model in this schema stores JSON (transcript, extractedData, metadata)
/// rather than introducing a second convention.
model AuditLog {
  id                 String   @id @default(cuid())
  // Who acted. Null only for system-initiated actions (scheduled jobs).
  actorId            String?
  actorEmail         String?
  actorRole          String?
  actorIp            String?
  actorUserAgent     String?
  // Set when the action was performed while impersonating a customer, so an
  // "impersonated" action is never mistaken for the customer's own.
  impersonatedUserId String?
  // Dotted verb: user.ban, wallet.credit, plan.delete, impersonation.start …
  action             String
  // user | billing | plan | number | agent | provider | security | system | content
  category           String   @default("general")
  targetType         String?
  targetId           String?
  // Denormalised human label (email / plan name) so the log reads without joins
  // and stays readable after the target row is gone.
  targetLabel        String?
  workspaceId        String?
  before             String?
  after              String?
  metadata           String   @default("{}")
  // success | failure — a blocked or errored attempt is itself security signal
  // and must be recorded, not silently dropped.
  status             String   @default("success")
  errorMessage       String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}
