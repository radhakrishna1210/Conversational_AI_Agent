generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model VoiceProvider {
  id           String    @id @default(cuid())
  name         String    @unique
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  voices       Voice[]

  @@index([name])
}

model Voice {
  id              String        @id @default(cuid())
  providerId      String
  providerVoiceId String
  name            String
  language        String?
  accent          String?
  gender          String?
  category        String?
  workspaceId     String?
  metadata        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  provider        VoiceProvider @relation(fields: [providerId], references: [id])

  @@unique([providerId, providerVoiceId])
  @@index([workspaceId, category])
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String?
  googleId      String?           @unique
  name          String
  avatarUrl     String?
  banned        Boolean           @default(false)
  bannedAt      DateTime?
  bannedReason  String?
  planName      String            @default("Free")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  mobile        String?           @unique
  refreshTokens RefreshToken[]
  memberships   WorkspaceMember[]
}

// The 20260809140000_remove_whatsapp migration tore WhatsApp out of the
// database — five Meta columns off Workspace, and nine whole tables. None of it
// was taken out of this file, and a stale schema here is not cosmetic: Prisma's
// default selection asks for every scalar it believes exists, so a bare
// `findFirst()` — or any `include` — asks Postgres for columns that are gone and
// fails with P2022. That is how the Meta columns took down password login,
// Google login and every workspace-scoped request at once, and how the leftover
// `Campaign.templateId` later took down the bulk-call page.
//
// The database is the source of truth. The WhatsApp models and their relations
// are gone from here now; if any of it is ever needed again it comes back
// through a migration that actually creates the table, not by being re-declared.
model Workspace {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  logoUrl             String?
  planName            String               @default("Starter")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  agents              Agent[]
  apiKeys             ApiKey[]
  broadcasts          Broadcast[]
  broadcastRecordings BroadcastRecording[]
  campaigns           Campaign[]
  compliance          WorkspaceCompliance?
  contacts            Contact[]
  contactClusters     ContactCluster[]
  customApiConfigs    CustomApiConfig[]
  integrations        Integration[]
  integrationLogs     IntegrationLog[]
  integrationSettings IntegrationSetting[]
  integrationTokens   IntegrationToken[]
  invoices            Invoice[]
  paymentOrders       PaymentOrder[]
  subscription        Subscription?
  notifications       Notification[]
  oauthSessions       OAuthSession[]
  plivoSubaccount     PlivoSubaccount?
  syncJobs            SyncJob[]
  voiceNumbers        VoiceNumber[]
  webhookEvents       WebhookEvent[]
  invites             WorkspaceInvite[]
  members             WorkspaceMember[]
  settings            WorkspaceSettings?
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("Member")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  workspaceId String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String    @default("Member")
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  environment String    @default("live")
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String              @id @default(cuid())
  workspaceId     String
  name            String
  // 'WHATSAPP' (template broadcast) or 'VOICE' (bulk calls).
  channel         String              @default("WHATSAPP")
  botId           String?
  phoneNumbers    Json?
  // ContactCluster ids this campaign was built from. Kept as the record of what
  // was chosen: the recipient rows are the frozen list, this is the intent, and
  // the two differ as soon as someone adds a contact to the cluster afterwards.
  clusterIds      Json?
  csvFileName     String?
  fromNumber      String?
  // Caller IDs rotated across calls, spreading volume to reduce spam flagging.
  fromNumbers     Json?
  // 'conversation' | 'greeting' — resolved from the agent's engine at launch.
  callMode        String?
  lastError       String?
  progress        Int                 @default(0)
  concurrentCalls Int                 @default(1)
  status          String              @default("DRAFT")
  scheduledAt     DateTime?
  launchedAt      DateTime?
  completedAt     DateTime?
  totalContacts   Int                 @default(0)
  sent            Int                 @default(0)
  failed          Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients      CampaignRecipient[]
}

model CampaignRecipient {
  id            String    @id @default(cuid())
  campaignId    String
  // phoneNumber is the dialling truth and stays denormalised: the list a
  // campaign dialled must not change when someone later edits or deletes the
  // contact behind it. contactId is the (nullable) link back, used to skip
  // opt-outs mid-flight and to credit the call to the right person.
  phoneNumber   String?
  contactId     String?
  callLogId     String?
  attempts      Int       @default(0)
  status        String    @default("pending")
  failureReason String?
  startedAt     DateTime?
  sentAt        DateTime?
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phoneNumber])
  @@index([campaignId, status])
  @@index([contactId])
}

/// A person this workspace may call.
///
/// One row per phone number per workspace: re-importing the same list updates
/// the existing row instead of creating a twin, so "how many people are we
/// calling" has one honest answer no matter how many CSVs arrived.
model Contact {
  id           String    @id @default(cuid())
  workspaceId  String
  // E.164, normalised on the way in — the unique key below depends on it, so an
  // un-normalised write would silently create a duplicate person.
  phoneNumber  String
  name         String?
  email        String?
  company      String?
  // Every other column of the CSV it arrived on, kept verbatim. Import is the
  // only chance to capture them; discarding them means a second upload just to
  // personalise a later campaign.
  attributes   Json?
  // ACTIVE | OPTED_OUT | INVALID. Only ACTIVE contacts are ever dialled.
  status       String    @default("ACTIVE")
  notes        String?
  lastCalledAt DateTime?
  callCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships         ContactClusterMember[]
  recipients          CampaignRecipient[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([workspaceId, phoneNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

/// A named list of contacts — the unit a campaign dials.
///
/// Every CSV uploaded while creating a campaign becomes one of these, so a list
/// is never trapped inside the campaign that happened to introduce it: it can be
/// renamed, added to, and re-dialled next month without a second upload.
model ContactCluster {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  // MANUAL | CSV_IMPORT | CAMPAIGN_CSV — where the list came from, which is what
  // makes an auto-created campaign list distinguishable from a curated one.
  source      String   @default("MANUAL")
  csvFileName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ContactClusterMember[]

  // Names are the handle people use to pick a list at launch time; two lists
  // called "Diwali leads" would make that choice a guess.
  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Membership join. Many-to-many on purpose: the same person can sit in several
/// lists without being duplicated, which is what makes cross-cluster dedupe at
/// launch a matter of counting rows rather than reconciling people.
model ContactClusterMember {
  id        String   @id @default(cuid())
  clusterId String
  contactId String
  addedAt   DateTime @default(now())

  cluster ContactCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  contact Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([clusterId, contactId])
  @@index([contactId])
}

/// ─── Voice broadcast (one-way) ───────────────────────────────────────────────
///
/// A broadcast dials the SAME contacts and clusters a bulk campaign dials, and
/// then does the one thing a campaign cannot: it plays a fixed recording and
/// hangs up. No agent, no speech-to-text, no LLM, no per-turn text-to-speech —
/// which is why it exists as its own table set rather than as another
/// `Campaign.channel`. Everything a campaign carries (botId, callMode, the
/// two-way telephony gates) is meaningless here, and everything a broadcast
/// carries (the audio asset, per-recipient answered/duration/charge) has nowhere
/// to live there.

/// One piece of audio, reusable across broadcasts.
///
/// Two ways in, one shape out: an uploaded MP3/WAV, or text synthesised once
/// through the same TTS provider the agents use. Synthesised once, deliberately
/// — a broadcast's whole cost advantage is that no speech is generated per call.
model BroadcastRecording {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  // UPLOAD | TTS — where the bytes came from. TTS rows keep `scriptText` and
  // `voiceId` so the same message can be re-rendered in another voice later.
  source        String   @default("UPLOAD")
  // Filename inside UPLOAD_DIR/broadcast-recordings. Never a full path: the
  // directory moves between environments, the file name does not.
  storedPath    String
  mimeType      String   @default("audio/mpeg")
  sizeBytes     Int      @default(0)
  // Whole seconds, rounded UP. This is the number every cost estimate and the
  // carrier's own billing increment are computed from, so rounding down would
  // under-quote every broadcast.
  durationSec   Int      @default(0)
  scriptText    String?
  voiceId       String?
  // READY | FAILED. A TTS render that fails leaves a row so the operator sees
  // why, instead of a recording that silently never appears.
  status        String   @default("READY")
  failureReason String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@index([workspaceId, createdAt])
}

/// One send: this recording, to these lists, from these caller IDs.
model Broadcast {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  recordingId     String
  // The clusters chosen, kept as the record of intent. The recipient rows are
  // the frozen list — the two diverge the moment someone edits a cluster, which
  // is what `sync-list` exists to reconcile.
  clusterIds      Json?
  // Caller IDs rotated across the dials, spreading volume so one number does not
  // absorb the whole day's spam scoring.
  fromNumbers     Json?
  fromNumber      String?
  // How many times the recording is played on one answered call. 2 is common for
  // short messages; the carrier bills the extra seconds, so it is priced.
  repeatCount     Int       @default(1)
  status          String    @default("DRAFT")
  scheduledAt     DateTime?
  launchedAt      DateTime?
  completedAt     DateTime?
  lastError       String?
  progress        Int       @default(0)
  totalRecipients Int       @default(0)
  // Answered is the number that matters commercially: an unanswered dial costs
  // nothing with the carrier and is never charged to the client.
  answered        Int       @default(0)
  failed          Int       @default(0)
  // Running total of what this broadcast has actually taken off the wallet, in
  // minor units. Derived from the recipient rows, never incremented blindly.
  spentCents      Int       @default(0)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recording  BroadcastRecording   @relation(fields: [recordingId], references: [id])
  recipients BroadcastRecipient[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

/// One dial. The unit of progress, of resumability, and of billing.
model BroadcastRecipient {
  id                 String    @id @default(cuid())
  broadcastId        String
  // Denormalised for the same reason CampaignRecipient denormalises it: the list
  // a broadcast dialled must not change when someone later edits or deletes the
  // contact behind it.
  phoneNumber        String
  contactId          String?
  // pending | calling | answered | no_answer | failed | skipped
  status             String    @default("pending")
  attempts           Int       @default(0)
  // The carrier's own call id (Twilio CallSid / Plivo call_uuid), which is how
  // the asynchronous status callback finds this row again.
  providerCallId     String?
  provider           String?
  fromNumber         String?
  durationSec        Int       @default(0)
  failureReason      String?
  startedAt          DateTime?
  answeredAt         DateTime?
  endedAt            DateTime?
  // PENDING | BILLED | SKIPPED. Same compare-and-set guard AgentCallLog uses:
  // a carrier callback that fires twice must not charge twice.
  billingStatus      String    @default("PENDING")
  billedCents        Int       @default(0)
  ratePerMinuteCents Int?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([broadcastId, phoneNumber])
  @@index([broadcastId, status])
  @@index([contactId])
  @@index([providerCallId])
}

model WorkspaceSettings {
  id                  String    @id @default(cuid())
  workspaceId         String    @unique
  timezone            String    @default("UTC")
  businessHoursJson   String?   @default("{}")
  notifyOnNewConv     Boolean   @default(true)
  notifyOnOptOut      Boolean   @default(true)
  notifyOnCampaignEnd Boolean   @default(true)
  notifyOnHighOptOut  Boolean   @default(false)
  notifyOnRateLimit   Boolean   @default(true)
  updatedAt           DateTime  @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String    @id @default(cuid())
  workspaceId    String
  planName       String
  amountCents    Int
  currency       String    @default("INR")
  status         String    @default("Paid")
  invoiceDate    DateTime
  pdfUrl         String?
  createdAt      DateTime  @default(now())
  // Human-facing sequential document number (INV-2026-000123). Unique so a
  // retried generation cannot mint two documents for the same payment.
  number         String?   @unique
  // topup | subscription
  type           String    @default("topup")
  subtotalCents  Int       @default(0)
  taxCents       Int       @default(0)
  // The payment this invoice documents. Unique: one invoice per payment, which
  // is what makes generation safe to retry.
  paymentOrderId String?   @unique
  periodStart    DateTime?
  periodEnd      DateTime?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, invoiceDate])
}

model Agent {
  id                   String            @id @default(cuid())
  workspaceId          String
  name                 String
  welcomeMessage       String
  aiModel              String
  voice                String
  transcription        String            @default("Azure")
  languages            String            @default("[]")
  flowItems            String?           @default("{}")
  maxDuration          Int               @default(30)
  silenceTimeout       Int               @default(5)
  dynamicEnabled       Boolean           @default(true)
  interruptibleEnabled Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  settings             String            @default("{}")
  // The DLT-approved voice template this agent's opening is registered under.
  // Required for Indian outbound: a template is only meaningful if the words
  // actually spoken match it, so the greeting is pinned to the approved body
  // rather than generated. Null for web calls and non-India traffic.
  dltTemplateId        String?
  dltTemplate          DltVoiceTemplate? @relation(fields: [dltTemplateId], references: [id], onDelete: SetNull)
  workspace            Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([dltTemplateId])
}

// Per-agent interaction history shown in Edit Agent → Recent Calls.
// Every test session is logged: text chats (CHAT), browser voice calls
// (WEB_CALL, with a full-call recording) and phone test calls (PHONE_CALL).
model AgentCallLog {
  id               String    @id @default(cuid())
  workspaceId      String
  agentId          String
  type             String    @default("CHAT") // CHAT | WEB_CALL | PHONE_CALL
  status           String    @default("COMPLETED") // IN_PROGRESS | COMPLETED | INITIATED | FAILED
  transcript       String    @default("[]") // JSON [{ role, content }]
  durationSec      Int       @default(0)
  recordingPath    String?
  recordingMime    String?
  phoneNumber      String?
  extractedData    String    @default("{}") // JSON: configured variables, values, evidence, model metadata
  extractionStatus String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | SKIPPED | FAILED
  extractionError  String?
  extractedAt      DateTime?
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── Billing (BUG-002) ──────────────────────────────────────────────────────
  // PENDING | BILLED | SKIPPED | FAILED. Guards against double-charging: all
  // three call-end paths converge on settleCall(), which only charges a call
  // still in PENDING.
  billingStatus      String    @default("PENDING")
  billedCents        Int       @default(0)
  billedAt           DateTime?
  // The customer-facing rate actually applied, snapshotted so a later plan or
  // FX change cannot retroactively alter what this call cost.
  ratePerMinuteCents Int?
  billedMinutes      Float     @default(0)
  // Measured provider COGS in micro-USD (millionths), RECORDED not charged —
  // the customer pays the rate card. This is what makes per-call margin
  // reportable instead of guessed.
  actualCostMicroUsd Int?

  @@index([workspaceId, agentId, startedAt])
  @@index([billingStatus, endedAt])
}

model Integration {
  id              String              @id @default(cuid())
  workspaceId     String
  provider        String
  name            String
  status          String              @default("disconnected")
  connected       Boolean             @default(false)
  accountId       String?
  accountLabel    String?
  lastSyncAt      DateTime?
  lastError       String?
  tokenExpiresAt  DateTime?
  webhookStatus   String              @default("not_configured")
  webhookEnabled  Boolean             @default(false)
  lastSyncedCount Int                 @default(0)
  metadata        String?             @default("{}")
  settingsJson    String              @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs            IntegrationLog[]
  settings        IntegrationSetting?
  token           IntegrationToken?
  oauthSessions   OAuthSession[]
  syncJobs        SyncJob[]
  webhookEvents   WebhookEvent[]

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
}

model IntegrationToken {
  id                 String      @id @default(cuid())
  integrationId      String      @unique
  workspaceId        String
  provider           String
  accessTokenCipher  String
  refreshTokenCipher String?
  tokenType          String?
  scopes             String      @default("")
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  integration        Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace          Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider])
}

model IntegrationLog {
  id            String       @id @default(cuid())
  workspaceId   String
  integrationId String?
  provider      String
  level         String       @default("info")
  event         String
  message       String
  status        String?
  metadata      String?      @default("{}")
  createdAt     DateTime     @default(now())
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider, createdAt])
}

model OAuthSession {
  id            String       @id @default(cuid())
  workspaceId   String
  integrationId String?
  provider      String
  userId        String?
  state         String       @unique
  codeVerifier  String?
  redirectUri   String?
  expiresAt     DateTime
  consumedAt    DateTime?
  metadata      String?      @default("{}")
  createdAt     DateTime     @default(now())
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider])
}

model WebhookEvent {
  id               String       @id @default(cuid())
  workspaceId      String
  integrationId    String?
  provider         String
  providerEventId  String?
  eventType        String
  payload          String
  headers          String?      @default("{}")
  signatureValid   Boolean      @default(true)
  processingStatus String       @default("received")
  processedAt      DateTime?
  error            String?
  createdAt        DateTime     @default(now())
  integration      Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider, createdAt])
}

model SyncJob {
  id            String       @id @default(cuid())
  workspaceId   String
  integrationId String?
  provider      String
  jobType       String       @default("manual")
  status        String       @default("queued")
  attempts      Int          @default(0)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  error         String?
  metadata      String?      @default("{}")
  createdAt     DateTime     @default(now())
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider, status])
}

model IntegrationSetting {
  id               String      @id @default(cuid())
  workspaceId      String
  integrationId    String      @unique
  provider         String
  settingsJson     String      @default("{}")
  enabled          Boolean     @default(true)
  webhookEnabled   Boolean     @default(false)
  selectedChannels String?     @default("[]")
  lastValidatedAt  DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  integration      Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider])
}

model CustomApiConfig {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  endpointUrl     String
  method          String    @default("GET")
  authType        String    @default("none")
  authValueCipher String?
  headersJson     String    @default("{}")
  queryParamsJson String    @default("{}")
  bodyTemplate    String?
  enabled         Boolean   @default(true)
  lastTestAt      DateTime?
  lastTestStatus  Int?
  lastTestError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, name])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  message     String
  type        String    @default("INFO")
  read        Boolean   @default(false)
  details     String?
  actionText  String?
  actionLink  String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, read, createdAt])
}

model ContactSubmission {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  callVolume String
  helpWith   String
  useCase    String
  heardAbout String?
  createdAt  DateTime @default(now())
}

model AppointmentBooking {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  projectType String
  role        String
  reason      String
  callVolume  String
  userType    String
  industry    String
  useCase     String
  createdAt   DateTime @default(now())
}

model ReportIssue {
  id            String   @id @default(cuid())
  issueTitle    String
  description   String
  screenshotUrl String?
  createdAt     DateTime @default(now())
}

model VerificationToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String
  purpose    String
  payload    String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model KbFile {
  id           String   @id @default(cuid())
  workspaceId  String
  uploadedById String
  agentId      String?
  fileName     String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  textContent  String?
  createdAt    DateTime @default(now())
  // Drives the startup sweep's "stuck" check (kbChunking.service.js) — a file
  // whose status hasn't moved in a while is presumed abandoned by a crashed
  // process, not still legitimately running. createdAt alone would be wrong
  // here: it never changes, so a file stuck on its SECOND processing attempt
  // (first attempt updated status, then crashed) would look falsely fresh.
  updatedAt    DateTime @updatedAt

  // RAG processing state. 'ready' is the default so every pre-existing row is
  // unaffected by this migration — it only ever applies to files large enough to
  // be chunked (see kbChunking.service.js). 'pending' -> 'processing' -> 'ready'
  // | 'failed'.
  status         String  @default("ready")
  // Flips true once this file's KbChunk rows exist with embeddings. While false,
  // getAgentKbText() still serves this file's textContent via the flat-text path
  // (today's behavior) — a large file is usable immediately and "graduates" to
  // retrieval-only once chunking finishes, never stuck unusable in between.
  chunked        Boolean @default(false)
  embeddingError String?

  @@index([workspaceId])
  @@index([workspaceId, agentId])
}

// One retrievable slice of a KbFile's text, embedded once at upload time. Only
// created for files whose extracted text exceeds the chunking threshold — see
// kbChunking.service.js. Deleted and reinserted (never appended to) on any
// re-processing attempt, so a retried job can't leave duplicate/stale chunks.
model KbChunk {
  id          String                       @id @default(cuid())
  kbFileId    String
  workspaceId String
  agentId     String?
  chunkIndex  Int
  content     String
  // pgvector column — Prisma models it as opaque (Unsupported), so the actual
  // `vector(1536)` type and its similarity index are declared in a hand-written
  // migration.sql rather than diffed from this schema. 1536 dims matches
  // Gemini's gemini-embedding-001 with output_dimensionality=1536 (also OpenAI
  // text-embedding-3-small's default width, kept dimension-compatible in case a
  // second provider is ever added — see embeddings.service.js).
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now())

  @@index([workspaceId, agentId])
  @@index([kbFileId])
}

model Plan {
  id                 String         @id @default(cuid())
  name               String         @unique
  priceUsd           Float
  perMinuteUsd       Float
  // INR is the price of record for this deployment. Nullable so a plan created
  // before this existed still works: money.js falls back to priceUsd x FX.
  // Keeping a real INR price (rather than deriving it) means a change to
  // FX_USD_TO_INR cannot silently reprice the product, and lets an admin set
  // round price points instead of 8,544.
  priceInr           Float?
  perMinuteInr       Float?
  // Mirrored Razorpay plan ids, kept per MODE. Test and live are separate
  // datasets — a plan created with rzp_test_ keys does not exist in live mode,
  // so one shared column would carry a test id into production and fail there.
  razorpayPlanIdTest String?
  razorpayPlanIdLive String?
  includedMinutes    Int
  kbStorageMb        Int            @default(100)
  // Enforceable limits. `features` is a marketing string list ("3 agents") and
  // was never machine-readable, so nothing could actually be gated on it.
  // These are the numbers assertCanStartCall() and agent creation check.
  maxAgents          Int            @default(1)
  maxConcurrentCalls Int            @default(1)
  features           String
  active             Boolean        @default(true)
  sortOrder          Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscriptions      Subscription[]
}

// Prepaid balance for one workspace, held in MINOR UNITS of `currency`
// (paise for INR). Never mutated directly — every change goes through
// applyWalletTransaction() in services/billing.service.js so that the balance
// and the ledger can never disagree.
model Wallet {
  id                   String              @id @default(cuid())
  workspaceId          String              @unique
  balanceCents         Int                 @default(0)
  // INR because that is what Razorpay settles in. Plans are catalogued in USD
  // and converted at charge time with the FX rate recorded on the transaction,
  // so a historical charge stays reproducible even after the rate moves.
  currency             String              @default("INR")
  // How far below zero this wallet may go before new calls are blocked.
  // 0 = hard stop at zero (the default). Non-zero lets an enterprise account
  // run on invoice terms without being cut off mid-conversation.
  overdraftLimitCents  Int                 @default(0)
  // Set when a low-balance warning was last sent, so the notifier does not
  // re-send on every single call once the balance is low.
  lowBalanceNotifiedAt DateTime?
  updatedAt            DateTime            @updatedAt
  transactions         WalletTransaction[]
}

// Append-only ledger. One row per balance mutation, and the ONLY audit record
// of money movement — nothing else is authoritative.
model WalletTransaction {
  id                String   @id @default(cuid())
  walletId          String
  // Signed: positive credits (top-up, refund, admin), negative debits (usage,
  // subscription). Summing this column for a wallet must always equal its
  // balanceCents; that invariant is asserted in the billing tests.
  amountCents       Int
  // Balance immediately AFTER this row was applied. Lets an auditor verify the
  // running balance without replaying the whole ledger, and makes an
  // out-of-order or lost write visible instead of silent.
  balanceAfterCents Int      @default(0)
  currency          String   @default("INR")
  // topup | usage | admin_credit | refund | subscription | adjustment
  type              String
  // THE double-charge guard. A retried Razorpay webhook, a double-fired
  // call-end event, or a client PATCH replay all carry the same key, and the
  // unique constraint makes the second write fail instead of charging twice.
  // Nullable because ad-hoc admin adjustments have no natural key, and
  // Postgres permits many NULLs under a UNIQUE index.
  idempotencyKey    String?  @unique
  note              String?
  // JSON: callLogId, durationSec, rate applied, provider ids — whatever is
  // needed to explain this line item back to a customer.
  metadata          String   @default("{}")
  // FX rate used when converting a USD-denominated plan rate into the wallet's
  // currency. Recorded per row so an old charge can be re-derived exactly.
  fxRateUsdToInr    Float?
  createdById       String?
  createdAt         DateTime @default(now())
  wallet            Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([type, createdAt])
}

// A workspace's current plan and billing period. Separate from
// Workspace.planName (a display string) because enforcement and renewal need
// real period boundaries and usage counters, not a label.
model Subscription {
  id                     String    @id @default(cuid())
  workspaceId            String    @unique
  planId                 String
  planName               String
  // active | past_due | cancelled | expired
  status                 String    @default("active")
  billingPeriod          String    @default("monthly") // monthly | yearly
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  // Downgrades and cancellations take effect at the period boundary, not
  // immediately — the customer already paid for this period.
  cancelAtPeriodEnd      Boolean   @default(false)
  pendingPlanId          String?
  cancelledAt            DateTime?
  // Included minutes for the CURRENT period, reset on renewal. Usage beyond
  // this draws down the wallet.
  minutesIncluded        Int       @default(0)
  minutesUsed            Float     @default(0)
  razorpaySubscriptionId String?   @unique
  // Renews itself on a saved card. False = the period simply lapses, which is
  // the pre-existing wallet-funded behaviour.
  autoRenew              Boolean   @default(false)
  // Last gateway charge applied, so a replayed subscription.charged webhook for
  // an already-processed cycle is recognisable.
  lastChargeId           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                   Plan      @relation(fields: [planId], references: [id])

  @@index([status, currentPeriodEnd])
  @@index([autoRenew, status])
}

// A payment initiated with the gateway. Created BEFORE the customer pays, so a
// webhook arriving for an unknown order is detectable as fraud/misroute rather
// than silently crediting a wallet.
model PaymentOrder {
  id                String    @id @default(cuid())
  workspaceId       String
  provider          String    @default("razorpay")
  providerOrderId   String    @unique
  providerPaymentId String?   @unique
  amountCents       Int
  currency          String    @default("INR")
  purpose           String    @default("topup") // topup | subscription
  planId            String?
  // created | paid | failed | refunded
  status            String    @default("created")
  notes             String    @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  paidAt            DateTime?
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

model documents {
  id          String   @id
  user_id     String
  file_name   String
  file_url    String
  uploaded_at DateTime @default(now())
}

// ─── ADMIN CONSOLE ────────────────────────────────────────────────────────────

/// Append-only record of every mutating action taken in the /admin panel.
///
/// Deliberately NOT related to User with a foreign key. An audit log whose rows
/// vanish when the actor is deleted is worthless precisely in the case you most
/// need it — "who deleted this account, and who deleted them?". `actorId` is a
/// bare string and `actorEmail` is denormalised at write time, so the trail
/// survives deletion of both actor and target.
///
/// `before`/`after` hold JSON snapshots as String, matching how every other
/// model in this schema stores JSON (transcript, extractedData, metadata)
/// rather than introducing a second convention.
model AuditLog {
  id                 String   @id @default(cuid())
  // Who acted. Null only for system-initiated actions (scheduled jobs).
  actorId            String?
  actorEmail         String?
  actorRole          String?
  actorIp            String?
  actorUserAgent     String?
  // Set when the action was performed while impersonating a customer, so an
  // "impersonated" action is never mistaken for the customer's own.
  impersonatedUserId String?
  // Dotted verb: user.ban, wallet.credit, plan.delete, impersonation.start …
  action             String
  // user | billing | plan | number | agent | provider | security | system | content
  category           String   @default("general")
  targetType         String?
  targetId           String?
  // Denormalised human label (email / plan name) so the log reads without joins
  // and stays readable after the target row is gone.
  targetLabel        String?
  workspaceId        String?
  before             String?
  after              String?
  metadata           String   @default("{}")
  // success | failure — a blocked or errored attempt is itself security signal
  // and must be recorded, not silently dropped.
  status             String   @default("success")
  errorMessage       String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

// ─── TRAI / DLT compliance ───────────────────────────────────────────────────
//
// India gates outbound commercial calling on two separate verifications, and
// neither can be performed by us on the client's behalf:
//
//   ENTITY — the client registers itself as a Principal Entity on an access
//     provider's DLT portal (Airtel, Jio, Vi, BSNL, Tata, ...) and receives a
//     19-digit PE ID. Once per client.
//   NUMBER — each caller ID is then registered as a voice CLI/header under that
//     PE ID. Once per number.
//
// The consequence for the product is that numbers cannot be bought in bulk and
// held: a carrier will only rent one against an approved per-customer
// compliance application, and the CLI is bound to that customer's PE ID from
// the moment it is provisioned. Provisioning therefore comes AFTER verification,
// not before.
//
// String enums rather than Prisma enums, matching the rest of this schema —
// see src/constants/compliance.js for the permitted values of every field.

model WorkspaceCompliance {
  id              String  @id @default(cuid())
  workspaceId     String  @unique
  // PROMOTIONAL | TRANSACTIONAL. Declared before a number is bought because it
  // decides the series, and the series cannot be changed afterwards without
  // releasing the number.
  useCase         String?
  // Legal entity as it appears on the registration documents. Must match the
  // brand name registered on DLT, or the header registration is rejected.
  entityName      String?
  legalEntityType String?

  // Our reseller compliance application to the carrier, filed per end customer.
  carrierApplicationStatus String    @default("NOT_SUBMITTED")
  carrierApplicationRef    String?
  carrierApplicationAt     DateTime?
  carrierRejectionReason   String?
  provider                 String    @default("PLIVO")

  // The client's DLT Principal Entity registration. peOperator is derived from
  // the first three digits of the PE ID.
  peId         String?
  peOperator   String?
  peStatus     String    @default("NOT_STARTED")
  peVerifiedAt DateTime?

  // PE-TM chain binding: the client declares our telemarketer (aggregator) ID
  // in their DLT portal. Without it the PE ID and our infrastructure are
  // unlinked and the traffic is unregistered however valid the PE is.
  tmId            String?
  tmBindingStatus String    @default("NOT_BOUND")
  tmBoundAt       DateTime?

  // Set when a violation is found. Independent of the checklist: a workspace
  // that satisfies every requirement can still be stopped.
  suspended       Boolean   @default(false)
  suspendedReason String?
  suspendedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents ComplianceDocument[]
  templates DltVoiceTemplate[]
}

model ComplianceDocument {
  id           String    @id @default(cuid())
  complianceId String
  // COI | UDYAM | PAN | GST | AUTH_LETTER | ADDRESS_PROOF
  kind         String
  fileName     String
  // Storage key, not the bytes. These are KYC documents; they do not belong in
  // a Postgres column and they do not belong in a public bucket.
  storageKey   String
  mimeType     String?
  sizeBytes    Int?
  status       String    @default("UPLOADED")
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  compliance WorkspaceCompliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)

  // One live document per kind; re-uploading replaces rather than accumulates.
  @@unique([complianceId, kind])
  @@index([complianceId, status])
}

model DltVoiceTemplate {
  id              String    @id @default(cuid())
  complianceId    String
  // The template ID issued by the DLT portal. Null while still a local draft.
  dltTemplateId   String?
  name            String
  // The approved script. The agent's opening must match this — a free-form LLM
  // greeting is what makes a registered template meaningless.
  body            String
  status          String    @default("DRAFT")
  rejectionReason String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  compliance WorkspaceCompliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  agents     Agent[]

  @@index([complianceId, status])
}

// One Plivo subaccount per workspace. Isolation and attribution only — NOT a
// billing boundary: charges from every subaccount aggregate to our parent
// account. Never expose a Plivo balance to a client; the wallet is the only
// thing they see. See backend/docs/PLIVO_INTEGRATION.md §2.
model PlivoSubaccount {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  authId       String   @unique
  // Plivo returns the subaccount auth_token EXACTLY ONCE, in the creation
  // response, and it is never retrievable from the API again. Encrypted at rest
  // because it authenticates real, billable spend against our parent account.
  authTokenEnc String
  name         String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model VoiceNumber {
  id                    String    @id @default(cuid())
  workspaceId           String
  phoneNumber           String    @unique
  // PLIVO | TWILIO
  provider              String
  providerNumberId      String?
  // Per-workspace carrier subaccount, so one client's calling behaviour cannot
  // degrade the caller-ID reputation of another client's numbers.
  subaccountId          String?
  // PROMOTIONAL_140 | TRANSACTIONAL_LANDLINE | BFSI_1600 | MOBILE | UNKNOWN.
  // Recorded from what the carrier sold us — 140 and 1600 are the only series
  // decidable from the digits, landline and mobile ranges overlap.
  series                String    @default("UNKNOWN")
  headerStatus          String    @default("NOT_REGISTERED")
  headerRejectionReason String?
  headerRegisteredAt    DateTime?
  status                String    @default("ACTIVE")
  assignedAt            DateTime  @default(now())
  releasedAt            DateTime?
  // Rolling reputation guard. A number's answer rate collapsing is the earliest
  // signal that carriers have started filtering it.
  dailyDialCap          Int       @default(200)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}
